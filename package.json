{
  "name": "glocktimizer-windows",
  "version": "1.2.0",
  "description": "Optimizador de Windows inspirado en Hone; ajustes reversibles por usuario.",
  "main": "main.cjs",
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tocelpepo-crypto/hogar-en-orden-real.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.glocktimizer.desktop",
    "productName": "Glocktimizer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Glocktimizer-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Glocktimizer"
    }
  }
}
